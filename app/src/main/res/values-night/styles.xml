<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#ADC6FF</item>
        <item name="android:colorBackground">#111418</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#111418</item>
    </style>
    <style name="AppDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#ADC6FF</item>
        <item name="android:colorBackground">#1B2028</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
    </style>
</resources>
